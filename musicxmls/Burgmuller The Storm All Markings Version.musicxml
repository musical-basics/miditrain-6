 <credit page="1">
  <credit-words default-x="696" default-y="133" font-family="Palatino" font-style="normal" font-size="19.497" font-weight="normal" justify="center" valign="middle">Burgmuller&apos;s L&apos;Orage (The Storm)</credit-words>
 </credit>
 <credit page="1">
  <credit-words default-x="696" default-y="97" font-family="Palatino" font-style="normal" font-size="10.5723" font-weight="normal" justify="center" valign="middle">Educational Version</credit-words>
 </credit>
 <credit page="1">
  <credit-words default-x="1328" default-y="84" font-family="Palatino" font-style="normal" font-size="9.7485" font-weight="normal" justify="right" valign="middle">Lionel Yu</credit-words>
 </credit>
 <credit page="2">
  <credit-words default-x="64" default-y="1738" font-style="normal" font-weight="normal" justify="left" valign="middle">2</credit-words>
 </credit>
 <credit page="3">
  <credit-words default-x="1328" default-y="1738" font-style="normal" font-weight="normal" justify="left" valign="middle">3</credit-words>
 </credit>
 <credit page="1">
  <credit-words default-x="64" default-y="222" font-family="Palatino" font-style="normal" font-size="8.9247" font-weight="normal" justify="left" valign="middle">Educational Versions are used for Lionel Yu&apos;s students only. ALL fingerings are given, so that the student does not waste time practicing the 
wrong fingering. However, if the student discovers a fingering that works better for them, they can write in a new fingering. 

Students are encouraged to print out the sheets in color. They are encouraged to use a RED pen to write fingerings &amp; circle markings that 
they consider important. 

Two forms of counting are given. The student should start learning with the light blue version, and then progress to the purple version once 
they are more familiar with the piece.</credit-words>
 </credit>
 <credit page="2">
  <credit-words default-x="1328" default-y="222" font-family="Palatino" font-style="normal" font-size="8.9247" font-weight="normal" justify="right" valign="middle">Educational Versions are used for Lionel Yu&apos;s students only. ALL fingerings are given, so that the student does not waste time practicing the 
wrong fingering. However, if the student discovers a fingering that works better for them, they can write in a new fingering. 

Students are encouraged to print out the sheets in color. They are encouraged to use a RED pen to write fingerings &amp; circle markings that 
they consider important. 

Two forms of counting are given. The student should start learning with the light blue version, and then progress to the purple version once 
they are more familiar with the piece.</credit-words>
 </credit>
 <credit page="3">
  <credit-words default-x="64" default-y="222" font-family="Palatino" font-style="normal" font-size="8.9247" font-weight="normal" justify="left" valign="middle">Educational Versions are used for Lionel Yu&apos;s students only. ALL fingerings are given, so that the student does not waste time practicing the 
wrong fingering. However, if the student discovers a fingering that works better for them, they can write in a new fingering. 

Students are encouraged to print out the sheets in color. They are encouraged to use a RED pen to write fingerings &amp; circle markings that 
they consider important. 

Two forms of counting are given. The student should start learning with the light blue version, and then progress to the purple version once 
they are more familiar with the piece.</credit-words>
 </credit>
 <credit page="1">
  <credit-words default-x="64" default-y="457" font-family="Palatino" font-style="normal" font-size="8.9247" font-weight="normal" justify="left" valign="middle">agitato = agitated, intense
a tempo ma un poco piu lento = back to original tempo but slightly slower
con fuoco = with fire
cresc. assai = intense crescendo
dimin. e rall. = diminuendo (get softer) + rallentando (reduce speed)
espressivo = expressively</credit-words>
 </credit>
 <credit page="2">
  <credit-words default-x="1328" default-y="457" font-family="Palatino" font-style="normal" font-size="8.9247" font-weight="normal" justify="right" valign="middle">agitato = agitated, intense
a tempo ma un poco piu lento = back to original tempo but slightly slower
con fuoco = with fire
cresc. assai = intense crescendo
dimin. e rall. = diminuendo (get softer) + rallentando (reduce speed)
espressivo = expressively</credit-words>
 </credit>
 <credit page="3">
  <credit-words default-x="64" default-y="457" font-family="Palatino" font-style="normal" font-size="8.9247" font-weight="normal" justify="left" valign="middle">agitato = agitated, intense
a tempo ma un poco piu lento = back to original tempo but slightly slower
con fuoco = with fire
cresc. assai = intense crescendo
dimin. e rall. = diminuendo (get softer) + rallentando (reduce speed)
espressivo = expressively</credit-words>
 </credit>
